# === Entornos Virtuales ===
venv/
.venv/
env/
ENV/
pyvenv.cfg
include/
lib/
share/

# === Base de Datos Local (SQLite) ===
*.db
*.sqlite
*.sqlite3

# === Caché de Python (Crucial para evitar basura en los commits) ===
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# === Configuraciones del Editor (VS Code / Cursor / PyCharm / Android Studio) ===
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# === Archivos del Sistema Operativo ===
.DS_Store
Thumbs.db

# =======================================================================
# NUEVO: COMPONENTES DE FLUTTER / MOBILE (Crucial para el Monorepo)
# =======================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Ignorar las carpetas de compilación (reemplaza 'mobile' si tu carpeta tiene otro nombre)
/mobile/build/
/mobile/android/.gradle/
/mobile/android/local.properties
/mobile/android/app/Flutter/
/mobile/android/app/libs/
/mobile/android/app/src/main/java/io/flutter/plugins/

# Ignorar los ejecutables generados
*.apk
*.ap_
*.aab
/mobile/ios/.symlinks/
/mobile/ios/Pods/
/mobile/ios/Flutter/Generated.xcconfig
/mobile/ios/Flutter/flutter_export_environment.sh

# --- Configuración y Caché de Godot ---
.godot/
.import/
export_presets.cfg

# --- Archivos específicos de Mono/C# (Si usas C#) ---
.mono/
data_*/
mono_crash_*.log
*.csproj
*.sln

# --- Archivos de configuración del Editor/Usuario ---
.user/
*.translation

# --- Binarios y Exports (Crea una carpeta 'builds' para tus ejecutables) ---
builds/
*.apk
*.exe
*.zip
*.dmg

